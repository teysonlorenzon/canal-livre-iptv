{
  "name": "zapp-iptv-webos",
  "private": true,
  "description": "Empacota o Zapp IPTV como app para TVs LG (webOS).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && ares-package dist -o out --no-minify",
    "install-tv": "node -e \"const a=require('./appinfo.json');require('child_process').execSync('ares-install --device tv out/'+a.id+'_'+a.version+'_all.ipk',{stdio:'inherit'})\"",
    "launch": "node -e \"require('child_process').execSync('ares-launch --device tv '+require('./appinfo.json').id,{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6"
  }
}
