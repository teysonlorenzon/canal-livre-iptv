{
  "name": "zapp-iptv",
  "productName": "Zapp IPTV",
  "version": "1.1.3",
  "private": true,
  "description": "Zapp IPTV: player web e empacotamento para TV LG, desktop (Windows/Linux) e celular (Android/iOS).",
  "type": "module",
  "author": {
    "name": "Zapp IPTV",
    "email": "47832168+teysonlorenzon@users.noreply.github.com"
  },
  "homepage": "https://github.com/teysonlorenzon/canal-livre-iptv",
  "main": "apps/desktop/app/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:build": "node tools/build-web.ts",
    "web:dev": "node tools/dev-server.ts",
    "tv:build": "node apps/tv-webos/build.ts",
    "tv:package": "node apps/tv-webos/build.ts && ares-package apps/tv-webos/dist -o apps/tv-webos/out --no-minify",
    "tv:install": "node -e \"const a=require('./apps/tv-webos/appinfo.json');require('child_process').execSync('ares-install --device tv apps/tv-webos/out/'+a.id+'_'+a.version+'_all.ipk',{stdio:'inherit'})\"",
    "tv:launch": "node -e \"require('child_process').execSync('ares-launch --device tv '+require('./apps/tv-webos/appinfo.json').id,{stdio:'inherit'})\"",
    "desktop:build": "node apps/desktop/build.ts",
    "desktop:start": "node apps/desktop/build.ts && electron .",
    "desktop:dist:linux": "node apps/desktop/build.ts && electron-builder --linux",
    "desktop:dist:win": "node apps/desktop/build.ts && electron-builder --win",
    "mobile:build": "node apps/mobile/build.ts",
    "mobile:sync": "node apps/mobile/build.ts && cap sync",
    "mobile:icons": "node apps/mobile/icons.ts",
    "android:apk": "node apps/mobile/build.ts && cap sync android && cd apps/mobile/android && ./gradlew assembleDebug",
    "android:aab": "node apps/mobile/build.ts && cap sync android && cd apps/mobile/android && ./gradlew bundleRelease",
    "android:install": "adb install -r apps/mobile/android/app/build/outputs/apk/debug/app-debug.apk",
    "ios:sync": "node apps/mobile/build.ts && cap sync ios"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@webos-tools/cli": "3.2.6",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "hls.js": "1.5.13",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mpegts.js": "1.7.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "build": {
    "appId": "com.zappiptv.desktop",
    "productName": "Zapp IPTV",
    "directories": {
      "output": "apps/desktop/out",
      "buildResources": "apps/desktop/build"
    },
    "files": [
      "apps/desktop/app/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "apps/desktop/build/icon.png",
      "maintainer": "Zapp IPTV"
    },
    "deb": {
      "packageName": "zapp-iptv-desktop"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "apps/desktop/build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Zapp IPTV"
    }
  }
}
